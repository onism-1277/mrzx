<script>
const REPO = 'onism-1277/mrzx';
const FILE_PATH = 'favorites.json';
let currentFavorites = null;
let currentSha = null;

// 工具函数：安全解码包含中文/UTF-8 的 Base64
function utf8Atob(str) {
  const cleanStr = str.replace(/\s/g, ''); // 清除 GitHub 返回的 Base64 换行符
  return decodeURIComponent(
    Array.prototype.map.call(atob(cleanStr), function (c) {
      return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
    }).join('')
  );
}

// 工具函数：安全编码包含中文/UTF-8 的 Base64
function utf8Btoa(str) {
  return btoa(
    encodeURIComponent(str).replace(/%([0-9A-F]{2})/g, function (match, p1) {
      return String.fromCharCode('0x' + p1);
    })
  );
}

function getToken() {
  return localStorage.getItem('gh_token') || '';
}

function saveToken() {
  const tokenInput = document.getElementById('tokenInput');
  const token = tokenInput ? tokenInput.value.trim() : '';
  if (token) {
    localStorage.setItem('gh_token', token);
    location.reload();
  }
}

async function loadFavorites() {
  const token = getToken();
  const tokenBox = document.getElementById('tokenBox');
  const container = document.getElementById('favoritesContainer');

  if (!container) return;

  if (!token) {
    if (tokenBox) tokenBox.style.display = 'block';
    container.innerHTML = '<p class="empty">请先设置 GitHub Token</p>';
    return;
  }

  if (tokenBox) tokenBox.style.display = 'none';

  try {
    const resp = await fetch('https://api.github.com/repos/' + REPO + '/contents/' + FILE_PATH, {
      headers: { 
        'Authorization': 'Bearer ' + token,
        'Accept': 'application/vnd.github.v3+json'
      }
    });

    if (resp.status === 404) {
      currentFavorites = { collections: ["默认收藏夹"], favorites: {} };
      currentSha = null;
      renderFavorites();
      return;
    }

    if (!resp.ok) {
      throw new Error(`请求失败 (${resp.status}): ${resp.statusText}`);
    }

    const data = await resp.json();
    currentSha = data.sha;
    // 使用 UTF-8 安全解码
    currentFavorites = JSON.parse(utf8Atob(data.content));
    renderFavorites();
  } catch (e) {
    container.innerHTML = '<p class="empty">加载失败: ' + e.message + '</p>';
  }
}

function renderFavorites() {
  const collections = (currentFavorites && currentFavorites.collections) || [];
  const favorites = (currentFavorites && currentFavorites.favorites) || {};
  const container = document.getElementById('favoritesContainer');

  if (!container) return;

  if (collections.length === 0) {
    container.innerHTML = '<p class="empty">暂无收藏</p>';
    return;
  }

  let html = '';
  html += '<div style="text-align:center;margin-bottom:1rem;">' +
    '<input type="text" id="newCollectionName" placeholder="新收藏夹名称" style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;margin-right:0.5rem;">' +
    '<button onclick="addCollection()" style="padding:0.4rem 1rem;background:#27ae60;color:white;border:none;border-radius:4px;cursor:pointer;">+ 新建收藏夹</button>' +
    '</div>';

  for (let i = 0; i < collections.length; i++) {
    const coll = collections[i];
    const papers = [];
    for (const key in favorites) {
      if (favorites[key] && favorites[key].collection === coll) {
        papers.push({ key: key, data: favorites[key] });
      }
    }

    html += '<div class="collection-section">';
    html += '<div class="collection-header">' +
      '<span class="collection-title">📂 ' + coll + ' (' + papers.length + ')</span>' +
      (coll !== '默认收藏夹' ? '<button class="btn-remove" onclick="deleteCollection(\'' + coll.replace(/'/g, "\\'") + '\')">删除收藏夹</button>' : '') +
      '</div>';

    if (papers.length === 0) {
      html += '<p class="empty">空</p>';
    }

    for (let j = 0; j < papers.length; j++) {
      const p = papers[j].data;
      const pmid = papers[j].key;
      html += '<div class="paper">';
      html += '<div class="paper-title"><a href="' + p.url + '" target="_blank" rel="noopener">' + p.title + '</a></div>';
      if (p.title_cn) {
        html += '<div class="paper-title-cn">' + p.title_cn + '</div>';
      }
      html += '<div class="paper-meta">' +
        '<span>' + (p.journal || '') + ' · ' + (p.date || '') + ' · 收藏于 ' + (p.addedAt || '') + '</span>' +
        '<button class="btn-remove" onclick="removeFavorite(\'' + pmid.replace(/'/g, "\\'") + '\')">移除</button>' +
        '</div>';
      html += '</div>';
    }
    html += '</div>';
  }

  container.innerHTML = html;
}

async function saveFavorites() {
  const token = getToken();
  if (!token) return;

  // 使用 UTF-8 安全编码
  const newContent = utf8Btoa(JSON.stringify(currentFavorites, null, 2));

  try {
    const resp = await fetch('https://api.github.com/repos/' + REPO + '/contents/' + FILE_PATH, {
      method: 'PUT',
      headers: {
        'Authorization': 'Bearer ' + token,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        message: 'update favorites',
        content: newContent,
        ...(currentSha ? { sha: currentSha } : {})
      })
    });
    const data = await resp.json();
    if (data.content && data.content.sha) {
      currentSha = data.content.sha;
    }
  } catch (e) {
    alert('保存失败: ' + e.message);
  }
}

async function addCollection() {
  const nameInput = document.getElementById('newCollectionName');
  const name = nameInput ? nameInput.value.trim() : '';
  if (!name) {
    alert('请输入收藏夹名称');
    return;
  }
  if (!currentFavorites.collections) {
    currentFavorites.collections = [];
  }
  if (currentFavorites.collections.indexOf(name) === -1) {
    currentFavorites.collections.push(name);
    await saveFavorites();
    renderFavorites();
  } else {
    alert('收藏夹已存在');
  }
}

async function deleteCollection(name) {
  if (!confirm('确定删除收藏夹 "' + name + '" 吗？')) return;
  currentFavorites.collections = currentFavorites.collections.filter(function(c) { return c !== name; });
  for (const key in currentFavorites.favorites) {
    if (currentFavorites.favorites[key] && currentFavorites.favorites[key].collection === name) {
      currentFavorites.favorites[key].collection = '默认收藏夹';
    }
  }
  await saveFavorites();
  renderFavorites();
}

async function removeFavorite(pmid) {
  if (!confirm('确定移除这篇论文吗？')) return;
  delete currentFavorites.favorites[pmid];
  await saveFavorites();
  renderFavorites();
}

// 显式挂载到 window 确保 onclick 事件顺利触发（针对 Astro / ES Module 环境）
window.addCollection = addCollection;
window.deleteCollection = deleteCollection;
window.removeFavorite = removeFavorite;
window.saveToken = saveToken;

// 初始化绑定与加载
document.addEventListener('DOMContentLoaded', function() {
  const saveBtn = document.getElementById('saveTokenBtn');
  if (saveBtn) {
    saveBtn.addEventListener('click', saveToken);
  }
  loadFavorites();
});

// 若脚本延迟加载，兜底直接运行一次
if (document.readyState === 'complete' || document.readyState === 'interactive') {
  loadFavorites();
}
</script>