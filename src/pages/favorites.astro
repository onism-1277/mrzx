<script>
const REPO = 'onism-1277/mrzx';
const FILE_PATH = 'favorites.json';
let currentFavorites = null;
let currentSha = null;

function getToken() {
  return localStorage.getItem('gh_token') || '';
}

function saveToken() {
  const tokenInput = document.getElementById('tokenInput');
  const token = tokenInput ? tokenInput.value.trim() : '';
  if (token) {
    localStorage.setItem('gh_token', token);
    location.reload();
  }
}

async function loadFavorites() {
  const token = getToken();
  const tokenBox = document.getElementById('tokenBox');
  const container = document.getElementById('favoritesContainer');

  if (!token) {
    tokenBox.style.display = 'block';
    container.innerHTML = '<p class="empty">请先设置 GitHub Token</p>';
    return;
  }

  tokenBox.style.display = 'none';

  try {
    const resp = await fetch('https://api.github.com/repos/' + REPO + '/contents/' + FILE_PATH, {
      headers: { 'Authorization': 'Bearer ' + token }
    });

    if (resp.status === 404) {
      currentFavorites = { collections: ["默认收藏夹"], favorites: {} };
      currentSha = null;
      renderFavorites();
      return;
    }

    const data = await resp.json();
    currentSha = data.sha;
    currentFavorites = JSON.parse(atob(data.content));
    renderFavorites();
  } catch (e) {
    container.innerHTML = '<p class="empty">加载失败: ' + e.message + '</p>';
  }
}

function renderFavorites() {
  const collections = currentFavorites.collections || [];
  const favorites = currentFavorites.favorites || {};
  const container = document.getElementById('favoritesContainer');

  if (collections.length === 0) {
    container.innerHTML = '<p class="empty">暂无收藏</p>';
    return;
  }

  let html = '';
  html += '<div style="text-align:center;margin-bottom:1rem;">' +
    '<input type="text" id="newCollectionName" placeholder="新收藏夹名称" style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">' +
    '<button onclick="addCollection()" style="padding:0.4rem 1rem;background:#27ae60;color:white;border:none;border-radius:4px;cursor:pointer;">+ 新建收藏夹</button>' +
    '</div>';

  for (let i = 0; i < collections.length; i++) {
    const coll = collections[i];
    const papers = [];
    for (const key in favorites) {
      if (favorites[key].collection === coll) {
        papers.push({ key: key, data: favorites[key] });
      }
    }

    html += '<div class="collection-section">';
    html += '<div class="collection-header">' +
      '<span class="collection-title">📂 ' + coll + ' (' + papers.length + ')</span>' +
      (coll !== '默认收藏夹' ? '<button class="btn-remove" onclick="deleteCollection(\'' + coll + '\')">删除收藏夹</button>' : '') +
      '</div>';

    if (papers.length === 0) {
      html += '<p class="empty">空</p>';
    }

    for (let j = 0; j < papers.length; j++) {
      const p = papers[j].data;
      const pmid = papers[j].key;
      html += '<div class="paper">';
      html += '<div class="paper-title"><a href="' + p.url + '" target="_blank" rel="noopener">' + p.title + '</a></div>';
      if (p.title_cn) {
        html += '<div class="paper-title-cn">' + p.title_cn + '</div>';
      }
      html += '<div class="paper-meta">' +
        '<span>' + (p.journal || '') + ' · ' + (p.date || '') + ' · 收藏于 ' + (p.addedAt || '') + '</span>' +
        '<button class="btn-remove" onclick="removeFavorite(\'' + pmid + '\')">移除</button>' +
        '</div>';
      html += '</div>';
    }
    html += '</div>';
  }

  container.innerHTML = html;
}

async function saveFavorites() {
  const token = getToken();
  const newContent = btoa(unescape(encodeURIComponent(JSON.stringify(currentFavorites, null, 2))));

  const resp = await fetch('https://api.github.com/repos/' + REPO + '/contents/' + FILE_PATH, {
    method: 'PUT',
    headers: {
      'Authorization': 'Bearer ' + token,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      message: 'update favorites',
      content: newContent,
      ...(currentSha ? { sha: currentSha } : {})
    })
  });
  const data = await resp.json();
  currentSha = data.content.sha;
}

async function addCollection() {
  const nameInput = document.getElementById('newCollectionName');
  const name = nameInput ? nameInput.value.trim() : '';
  if (!name) {
    alert('请输入收藏夹名称');
    return;
  }
  if (currentFavorites.collections.indexOf(name) === -1) {
    currentFavorites.collections.push(name);
    await saveFavorites();
    renderFavorites();
  } else {
    alert('收藏夹已存在');
  }
}

async function deleteCollection(name) {
  if (!confirm('确定删除收藏夹 "' + name + '" 吗？')) return;
  currentFavorites.collections = currentFavorites.collections.filter(function(c) { return c !== name; });
  for (const key in currentFavorites.favorites) {
    if (currentFavorites.favorites[key].collection === name) {
      currentFavorites.favorites[key].collection = '默认收藏夹';
    }
  }
  await saveFavorites();
  renderFavorites();
}

async function removeFavorite(pmid) {
  if (!confirm('确定移除这篇论文吗？')) return;
  delete currentFavorites.favorites[pmid];
  await saveFavorites();
  renderFavorites();
}

// Event listener for save button
document.addEventListener('DOMContentLoaded', function() {
  const saveBtn = document.getElementById('saveTokenBtn');
  if (saveBtn) {
    saveBtn.addEventListener('click', saveToken);
  }
});

// Initialize
loadFavorites();
</script>